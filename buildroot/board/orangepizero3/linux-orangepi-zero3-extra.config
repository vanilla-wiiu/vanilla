# Extra kernel config fragment for the Orange Pi Zero 3 (H618) vendor kernel.
#
# The vendor's drivers/net/phy/sunxi-ephy.c is compiled into libphy
# unconditionally and hardcodes `#if 1` in place of the original
# CONFIG_MFD_ACX00 / CONFIG_ARCH_SUN50IW9 guards, so it always references
# ac200_enable() and sun50i_ephy_calibrate_value() from drivers/mfd/sunxi-ac200.c.
# Those symbols only exist when MFD_AC200 is built, so vmlinux fails to link
# without it. The stock linux_sunxi64_defconfig omits MFD_AC200.
CONFIG_MFD_AC200=y

# CONFIG_RTL8821CU is not set
