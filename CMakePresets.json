{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "ios-device",
      "displayName": "iOS device",
      "description": "arm64 device build with an Xcode-compatible deployment target",
      "generator": "Xcode",
      "toolchainFile": "${sourceDir}/cmake/ios-toolchain.cmake",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_POLICY_VERSION_MINIMUM": "3.5"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "ios-device-release",
      "configurePreset": "ios-device",
      "configuration": "Release",
      "targets": ["vanilla"]
    },
    {
      "name": "ios-device-debug",
      "configurePreset": "ios-device",
      "configuration": "Debug",
      "targets": ["vanilla"]
    }
  ]
}
